## Database Schema

### Core Tables (Supabase / PostgreSQL)

```sql
-- Users profile (extends Supabase auth.users)
profiles (
  id uuid references auth.users primary key,
  name text,
  avatar_url text,
  onboarding_complete boolean default false,
  created_at timestamptz default now()
)

-- Daily check-ins
check_ins (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references profiles,
  date date not null,
  transcript text,                    -- raw voice transcript
  energy_level integer,               -- 1-10, extracted by AI
  mood text,                          -- extracted by AI
  social_battery integer,             -- 1-10
  oura_readiness integer,             -- from Oura API
  oura_sleep_score integer,
  ai_summary text,                    -- Arc's interpretation
  created_at timestamptz default now()
)

-- Daily quests
quests (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references profiles,
  date date not null,
  dimension text not null,            -- 'vitality' | 'mind' | 'create' | 'social' | 'love' | 'family' | 'wealth'
  title text not null,
  description text,
  xp_reward integer default 100,
  status text default 'pending',      -- 'pending' | 'completed' | 'skipped'
  proof_transcript text,              -- voice reflection on completion
  completed_at timestamptz,
  created_at timestamptz default now()
)

-- XP per dimension (running totals)
dimension_xp (
  user_id uuid references profiles,
  dimension text not null,
  total_xp integer default 0,
  level integer default 1,
  primary key (user_id, dimension)
)

-- Long-term goals
goals (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references profiles,
  dimension text not null,
  title text not null,
  description text,
  target_date date,
  status text default 'active',       -- 'active' | 'achieved' | 'abandoned'
  created_at timestamptz default now()
)

-- Memory entries (Witness mechanic)
memories (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references profiles,
  date date,
  content text not null,              -- what was said/felt/done
  type text,                          -- 'fear' | 'win' | 'reflection' | 'milestone'
  dimension text,
  surfaced_at timestamptz,            -- when Arc surfaced this to user
  created_at timestamptz default now()
)

-- Photo memories
photos (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references profiles,
  storage_path text,
  ai_description text,                -- Claude's interpretation
  taken_at timestamptz,               -- extracted from EXIF or AI guess
  location text,
  tags text[],
  dimension text,
  created_at timestamptz default now()
)

-- Achievements
user_achievements (
  user_id uuid references profiles,
  achievement_id text not null,
  unlocked_at timestamptz default now(),
  primary key (user_id, achievement_id)
)

-- Boss battles
boss_battles (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references profiles,
  week_start date,
  boss_name text,
  boss_type text,                     -- 'isolator' | 'procrastinator' | 'burnout' | 'comparator' | 'custom'
  description text,
  max_hp integer default 1000,
  current_hp integer default 1000,
  status text default 'active',       -- 'active' | 'defeated' | 'escaped'
  created_at timestamptz default now()
)
```

