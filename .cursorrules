```typescript
// src/types/index.ts

export type DimensionId = 'vitality' | 'mind' | 'create' | 'social' | 'love' | 'family' | 'wealth'

export interface CheckIn {
  id: string
  userId: string
  date: string
  transcript: string
  energyLevel: number        // 1-10
  mood: string
  socialBattery: number      // 1-10
  ouraReadiness?: number
  ouraSleepScore?: number
  aiSummary: string
  createdAt: string
}

export interface Quest {
  id: string
  userId: string
  date: string
  dimension: DimensionId
  title: string
  description: string
  xpReward: number
  status: 'pending' | 'completed' | 'skipped'
  proofTranscript?: string
  completedAt?: string
}

export interface DimensionXP {
  dimension: DimensionId
  totalXp: number
  level: number
}

export interface Memory {
  id: string
  date: string
  content: string
  type: 'fear' | 'win' | 'reflection' | 'milestone'
  dimension?: DimensionId
}

export interface BossBattle {
  id: string
  weekStart: string
  bossName: string
  bossType: 'isolator' | 'procrastinator' | 'burnout' | 'comparator' | 'custom'
  description: string
  maxHp: number
  currentHp: number
  status: 'active' | 'defeated' | 'escaped'
}

export interface OuraData {
  date: string
  readinessScore: number
  sleepScore: number
  hrvBalance?: number
  activityScore?: number
}

export interface DayDashboard {
  date: string
  checkIn?: CheckIn
  quests: Quest[]
  oura?: OuraData
  calendarEvents: CalendarEvent[]
  dimensionXP: DimensionXP[]
  activeBoss?: BossBattle
}

export interface CalendarEvent {
  id: string
  title: string
  startTime: string
  endTime: string
  location?: string
  isAfterWork: boolean
}
```

